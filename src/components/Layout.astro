---
import '../styles/global.css';
import site from '../data/site.json';
import Icon from './Icon.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
}

const { title, description, ogImage = '/og-image.png', canonical } = Astro.props;
const siteUrl = 'https://manuel-cordova.pages.dev';
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : siteUrl;
const { owner } = site;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Manuel Córdova" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-variable.woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-black text-white px-4 py-2 rounded z-50">
      Saltar al contenido
    </a>
    <header class="sticky top-0 z-40 bg-[--color-bg] border-b border-[--color-border] transition-all duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12">
        <nav class="flex items-center justify-between h-20">
          <a href="/" class="group block leading-tight">
            <span class="block text-[10px] uppercase tracking-[0.3em] text-[--color-text-soft] mb-0.5 transition-colors group-hover:text-[--color-gold]">Catálogo</span>
            <span class="block font-bold text-2xl tracking-tight text-[--color-text]">CONSTRULIBROS</span>
          </a>
          <div class="flex items-center gap-6">
            <span class="hidden md:block w-px h-8 bg-[--color-border]"></span>
            <span class="hidden md:block text-sm text-[--color-text-muted]">{owner.nombre}</span>
          </div>
        </nav>
      </div>
      <div class="h-px bg-gradient-to-r from-transparent via-[--color-gold] to-transparent"></div>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-[--color-border] py-16 mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12">
        <div class="flex flex-col md:flex-row items-center justify-between gap-8">
          <div class="text-center md:text-left">
            <p class="font-bold text-lg tracking-tight mb-1">CONSTRULIBROS</p>
            <p class="text-sm text-[--color-text-soft]">{owner.nombre} · Chile</p>
          </div>
          <div class="flex flex-col md:flex-row items-center gap-6">
            <a
              href={`mailto:${owner.email}`}
              class="inline-flex items-center gap-2 text-sm text-[--color-text-muted] hover:text-[--color-accent] transition-colors"
            >
              <Icon name="mail" size={16} />
              {owner.email}
            </a>
            <a
              href={`https://wa.me/${owner.whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm text-[--color-text-muted] hover:text-[--color-whatsapp] transition-colors"
            >
              <Icon name="whatsapp" size={16} />
              WhatsApp
            </a>
          </div>
        </div>
        <div class="mt-12 pt-8 border-t border-[--color-border] text-center">
          <p class="text-xs text-[--color-text-soft] tracking-wide">
            © {new Date().getFullYear()} CONSTRULIBROS · Todos los derechos reservados
          </p>
        </div>
      </div>
    </footer>
  </body>
  <script is:inline>
    window.addEventListener('scroll', () => {
      const header = document.querySelector('header');
      if (window.scrollY > 50) {
        header.classList.add('bg-[--color-bg]', 'backdrop-blur-md', 'shadow-sm');
      } else {
        header.classList.remove('bg-[--color-bg]', 'backdrop-blur-md', 'shadow-sm');
      }
    });
  </script>
</html>
