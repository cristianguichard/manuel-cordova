---
import '../styles/global.css';
import site from '../data/site.json';
import Icon from './Icon.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
}

const { title, description, ogImage = '/og-image.png', canonical } = Astro.props;
const siteUrl = 'https://manuel-cordova.pages.dev';
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : siteUrl;
const { owner } = site;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Manuel Córdova" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-variable.woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-black text-white px-4 py-2 rounded z-50">
      Saltar al contenido
    </a>
    <header class="sticky top-0 z-40 bg-white border-b border-[--color-border]">
      <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
        <nav class="flex items-center justify-between h-16">
          <a href="/" class="block leading-tight">
  <span class="block font-bold text-lg uppercase tracking-tight">CONSTRULIBROS</span>
  <span class="block text-sm text-[--color-text-muted]">Manuel Córdova</span>
</a>
        </nav>
      </div>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-[--color-border] py-12 mt-16">
      <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="flex flex-col md:flex-row items-center gap-4 md:gap-6">
            <a
              href={`mailto:${owner.email}`}
              class="inline-flex items-center gap-2 text-sm text-[--color-text-muted] hover:text-[--color-text] transition-colors"
            >
              <Icon name="mail" size={16} />
              {owner.email}
            </a>
            <a
              href={`https://wa.me/${owner.whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm text-[--color-text-muted] hover:text-[--color-text] transition-colors"
            >
              <Icon name="whatsapp" size={16} />
              WhatsApp
            </a>
          </div>
          <p class="text-sm text-[--color-text-soft]">Sitio creado en Astro + Tailwind</p>
        </div>
        <p class="text-center text-sm text-[--color-text-muted] mt-4">
          © {new Date().getFullYear()} CONSTRULIBROS
        </p>
      </div>
    </footer>
  </body>
</html>