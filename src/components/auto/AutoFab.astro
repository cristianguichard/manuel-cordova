---
import Icon from '../Icon.astro';

interface Contact {
  phone: string;
  prefillMessage: string;
}

interface Props {
  contact: Contact;
}

const { contact } = Astro.props;
const whatsappText = encodeURIComponent(contact.prefillMessage);
const whatsappUrl = `https://wa.me/${contact.phone}?text=${whatsappText}`;
---

<style>
  /* Hide on desktop (>= 768px). */
  @media (min-width: 768px) {
    .auto-fab {
      display: none !important;
    }
  }
  /* Hide while lightbox is open. */
  body[data-lightbox='open'] .auto-fab {
    transform: scale(0);
    opacity: 0;
    pointer-events: none;
  }

  @keyframes autoFabPulse {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.6), 0 8px 24px rgba(0, 0, 0, 0.18);
    }
    50% {
      box-shadow: 0 0 0 14px rgba(37, 211, 102, 0), 0 8px 24px rgba(0, 0, 0, 0.18);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .auto-fab {
      animation: autoFabPulse 2.5s ease-out infinite;
    }
  }
</style>

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="auto-fab fixed bottom-6 right-6 z-50 w-14 h-14 flex items-center justify-center rounded-full bg-[var(--color-whatsapp)] text-white focus:outline-none focus:ring-4 focus:ring-[var(--color-whatsapp)]/40 transition-transform duration-200"
  aria-label="Contactar por WhatsApp"
>
  <Icon name="whatsapp" size={28} />
</a>
