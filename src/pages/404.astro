---
import Layout from '../components/Layout.astro';
---

<Layout
  title="Página no encontrada — Biblioteca Manuel Córdova"
  description="La página que buscas no existe."
>
  <section class="py-24 text-center">
    <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
      <h1 class="font-bold text-4xl mb-4">Esta página no existe</h1>
      <p class="text-[--color-text-muted] mb-8">
        Puede que el libro que buscas haya sido movido o eliminado.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 text-[--color-accent] hover:text-[--color-accent-hover] transition-colors"
      >
        ← Volver al catálogo
      </a>
    </div>
  </section>
</Layout>