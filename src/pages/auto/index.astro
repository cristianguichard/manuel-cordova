---
import AutoLayout from '../../layouts/AutoLayout.astro';
import AutoHero from '../../components/auto/AutoHero.astro';
import AutoSpecTable from '../../components/auto/AutoSpecTable.astro';
import AutoGallery from '../../components/auto/AutoGallery.astro';
import AutoLightbox from '../../components/auto/AutoLightbox.astro';
import AutoContactSection from '../../components/auto/AutoContactSection.astro';
import AutoFab from '../../components/auto/AutoFab.astro';
import auto from '../../data/auto.json';
import frontImg from '../../assets/auto/front.webp';
import sideImg from '../../assets/auto/side.webp';
import rearImg from '../../assets/auto/rear.webp';
import interiorImg from '../../assets/auto/interior.webp';
import dashboardImg from '../../assets/auto/dashboard.webp';
import engineImg from '../../assets/auto/engine.webp';
import detail1Img from '../../assets/auto/detail-1.webp';
import detail2Img from '../../assets/auto/detail-2.webp';

const photoByName: Record<string, string> = {
  front: frontImg.src,
  side: sideImg.src,
  rear: rearImg.src,
  interior: interiorImg.src,
  dashboard: dashboardImg.src,
  engine: engineImg.src,
  'detail-1': detail1Img.src,
  'detail-2': detail2Img.src,
};

const photos = auto.photos.map((p) => ({
  ...p,
  src: photoByName[p.name] ?? '',
}));

const primary = photos.find((p) => p.isPrimary) ?? photos[0];
---

<AutoLayout
  title={auto.meta.title}
  description={auto.meta.description}
>
  <AutoHero car={auto.car} primaryPhoto={primary} contact={auto.contact} />
  <AutoSpecTable car={auto.car} />
  <AutoGallery photos={photos} />
  <AutoContactSection contact={auto.contact} />
  <AutoFab contact={auto.contact} />
  <AutoLightbox />
</AutoLayout>
