---
import AutoLayout from '../../layouts/AutoLayout.astro';
import AutoHero from '../../components/auto/AutoHero.astro';
import AutoSpecTable from '../../components/auto/AutoSpecTable.astro';
import AutoGallery from '../../components/auto/AutoGallery.astro';
import AutoLightbox from '../../components/auto/AutoLightbox.astro';
import AutoContactSection from '../../components/auto/AutoContactSection.astro';
import AutoFab from '../../components/auto/AutoFab.astro';
import auto from '../../data/auto.json';

// Dynamic, resilient import: only the WebPs that actually exist on disk are
// bundled. The mapping is by basename (without extension) so adding/removing
// photos in src/assets/auto/ never breaks the build.
const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/auto/*.webp',
  { eager: true },
);

const srcByBaseName: Record<string, string> = {};
for (const [path, mod] of Object.entries(photoModules)) {
  const fileName = path.split('/').pop() ?? '';
  const base = fileName.replace(/\.webp$/i, '');
  srcByBaseName[base] = mod.default.src;
}

const photos = auto.photos
  .map((p) => {
    const base = p.file.replace(/\.webp$/i, '');
    const src = srcByBaseName[base];
    return src ? { ...p, src } : null;
  })
  .filter((p): p is NonNullable<typeof p> => p !== null);

const primary = photos.find((p) => p.isPrimary) ?? photos[0];
---

<AutoLayout
  title={auto.meta.title}
  description={auto.meta.description}
  ogImage={primary?.src}
  ogImageAlt={primary?.alt ?? ''}
>
  <AutoHero
    car={auto.car}
    primaryPhoto={primary ?? { src: '', alt: '' }}
    contact={auto.contact}
  />
  <AutoSpecTable car={auto.car} />
  <AutoGallery photos={photos} />
  <AutoContactSection contact={auto.contact} />
  <AutoFab contact={auto.contact} />
  <AutoLightbox />
</AutoLayout>
