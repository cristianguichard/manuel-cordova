---
import Layout from '../components/Layout.astro';
import BookCard from '../components/BookCard.astro';
import BookFilter from '../components/BookFilter.astro';
import ContactButtons from '../components/ContactButtons.astro';
import librosData from '../data/libros.json';
import site from '../data/site.json';
import type { Libro } from '../types';

const libros = librosData as Libro[];
const temasUnicos = [...new Set(libros.map(l => l.tema))].sort();
const minPrecio = Math.min(...libros.map(l => l.precio));

const formatPrice = (precio: number) => {
  return new Intl.NumberFormat('es-CL', {
    style: 'currency',
    currency: 'CLP',
    maximumFractionDigits: 0
  }).format(precio);
};
---

<Layout
  title={`${site.site.nombre} — ${site.site.tagline}`}
  description={`Catálogo de ${libros.length} libros técnicos en venta. Temas: ${temasUnicos.join(', ')}.`}
>
  <section class="py-16 md:py-24 lg:py-32">
    <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
      <header class="mb-16 text-center">
        <div class="inline-flex items-center gap-3 mb-6">
          <span class="w-12 h-px bg-[--color-gold]"></span>
          <span class="text-[10px] uppercase tracking-[0.3em] text-[--color-gold]">Catálogo {new Date().getFullYear()}</span>
          <span class="w-12 h-px bg-[--color-gold]"></span>
        </div>
        
        <h1
          class="font-bold tracking-tighter uppercase mb-4 text-[--color-text] leading-[0.95]"
          style="font-size: clamp(2.25rem, 11vw, 5rem);"
        >
          CONSTRULIBROS
        </h1>
        
        <p class="text-xl md:text-2xl text-[--color-text-muted] mb-2">{site.owner.nombre}</p>
        
        {site.owner.bio !== 'MANUEL_BIO_AQUI' && (
          <p class="max-w-xl mx-auto text-[--color-text-muted] mt-6 leading-relaxed">{site.owner.bio}</p>
        )}
        
        <div class="mt-10 inline-flex items-center gap-8 text-sm">
          <div class="text-center">
            <p class="text-2xl font-bold text-[--color-text]">{libros.length}</p>
            <p class="text-[--color-text-soft] uppercase tracking-wider text-xs">Libros</p>
          </div>
          <div class="w-px h-10 bg-[--color-border]"></div>
          <div class="text-center">
            <p class="text-2xl font-bold text-[--color-text]">{temasUnicos.length}</p>
            <p class="text-[--color-text-soft] uppercase tracking-wider text-xs">Temas</p>
          </div>
          <div class="w-px h-10 bg-[--color-border]"></div>
          <div class="text-center">
            <p class="text-2xl font-bold text-[--color-accent]">Desde {formatPrice(minPrecio)}</p>
            <p class="text-[--color-text-soft] uppercase tracking-wider text-xs">Precio</p>
          </div>
        </div>
      </header>

      <div class="mb-12">
        <BookFilter temas={temasUnicos} />
      </div>

      <section id="libros-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {libros.map((libro, index) => (
          <div class="animate-fade-in-up h-full" style={`animation-delay: ${index * 50}ms`}>
            <BookCard libro={libro} />
          </div>
        ))}
      </section>

      <div class="mt-20 pt-12 border-t border-[--color-border] text-center">
        <p class="text-[--color-text-muted] mb-6">¿Te interesa algún libro? Contactá directamente</p>
        <ContactButtons />
      </div>
    </div>
  </section>
</Layout>
