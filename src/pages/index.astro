---
import Layout from '../components/Layout.astro';
import BookCard from '../components/BookCard.astro';
import BookFilter from '../components/BookFilter.astro';
import ContactButtons from '../components/ContactButtons.astro';
import librosData from '../data/libros.json';
import site from '../data/site.json';
import type { Libro } from '../types';

const libros = librosData as Libro[];
const temasUnicos = [...new Set(libros.map(l => l.tema))].sort();
const minPrecio = Math.min(...libros.map(l => l.precio));

const formatPrice = (precio: number) => {
  return new Intl.NumberFormat('es-CL', {
    style: 'currency',
    currency: 'CLP',
    maximumFractionDigits: 0
  }).format(precio);
};
---

<Layout
  title={`${site.site.nombre} — ${site.site.tagline}`}
  description={`Catálogo de ${libros.length} libros técnicos en venta. Temas: ${temasUnicos.join(', ')}.`}
>
  <section class="py-12 md:py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-6 md:px-8 lg:px-12">
      <div class="mb-12 text-center">
        <h1 class="font-bold text-4xl md:text-5xl lg:text-6xl tracking-tight uppercase mb-2">
          CONSTRULIBROS
        </h1>
        <p class="text-lg text-[--color-text-muted] mb-6">{site.owner.nombre}</p>
        {site.owner.bio !== 'MANUEL_BIO_AQUI' && (
          <p class="max-w-2xl mx-auto text-[--color-text-muted] mb-6">{site.owner.bio}</p>
        )}
        <p class="text-sm text-[--color-text-soft]">
          {libros.length} libros · {temasUnicos.length} temas · Precios desde {formatPrice(minPrecio)}
        </p>
      </div>

      <BookFilter temas={temasUnicos} />

      <section id="libros-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
        {libros.map(libro => (
          <BookCard libro={libro} />
        ))}
      </section>

      <div class="mt-16 text-center">
        <p class="text-[--color-text-muted] mb-4">¿Te interesa algún libro? Contactá directamente</p>
        <ContactButtons />
      </div>
    </div>
  </section>
</Layout>